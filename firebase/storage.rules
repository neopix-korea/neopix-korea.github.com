rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function teacher() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['dasahee@yeonsung.ac.kr'];
    }
    match /bootcampClassrooms/{room}/{uid}/{submission}/{image} {
      allow read: if request.auth != null && (request.auth.uid == uid || teacher());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }
  }
}
