rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teacher() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['dasahee@yeonsung.ac.kr'];
    }
    match /bootcampClassrooms/{room} {
      function student(id) { return get(/databases/$(database)/documents/bootcampClassrooms/$(room)/students/$(id)).data; }
      function device() { return get(/databases/$(database)/documents/bootcampClassrooms/$(room)/devices/$(request.auth.uid)).data; }
      function validImage(paths, index) {
        return paths.size() <= index || (paths[index] is string && paths[index].size() < 3000
          && paths[index].matches('https://firebasestorage[.]googleapis[.]com/v0/b/yeonsung-ac[.]firebasestorage[.]app/o/bootcampClassrooms%2F' + room + '%2F' + request.auth.uid + '%2F.+'));
      }
      match /students/{id} {
        allow read: if signedIn();
        allow create: if signedIn()
          && id.matches('[a-z0-9가-힣_-]{2,24}')
          && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /devices/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['studentId', 'seat', 'updatedAt'])
          && request.resource.data.studentId is string
          && exists(/databases/$(database)/documents/bootcampClassrooms/$(room)/students/$(request.resource.data.studentId))
          && request.resource.data.seat is int && request.resource.data.seat >= 1 && request.resource.data.seat <= 999
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /assignments/{id} {
        allow read: if signedIn();
        allow create: if teacher()
          && request.resource.data.keys().hasOnly(['title', 'description', 'open', 'createdBy', 'createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
          && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 4000
          && request.resource.data.open == true && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if teacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open']) && request.resource.data.open is bool;
        allow delete: if false;
      }
      match /submissions/{id} {
        allow read: if teacher() || (signedIn() && resource.data.studentId == device().studentId);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['assignmentId', 'studentId', 'name', 'seat', 'kind', 'url', 'description', 'images', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
          && request.resource.data.studentId == device().studentId
          && request.resource.data.name == student(device().studentId).name
          && request.resource.data.seat == device().seat
          && request.resource.data.assignmentId is string
          && get(/databases/$(database)/documents/bootcampClassrooms/$(room)/assignments/$(request.resource.data.assignmentId)).data.open == true
          && request.resource.data.kind in ['website', 'music', 'image']
          && request.resource.data.url is string && request.resource.data.url.size() <= 2000
          && (request.resource.data.url == '' || request.resource.data.url.matches('https?://.+'))
          && request.resource.data.description is string && request.resource.data.description.size() <= 2000
          && request.resource.data.images is list && request.resource.data.images.size() <= 3
          && validImage(request.resource.data.images, 0) && validImage(request.resource.data.images, 1) && validImage(request.resource.data.images, 2)
          && (request.resource.data.url.size() > 0 || request.resource.data.images.size() > 0);
        allow update, delete: if false;
      }
    }
  }
}
